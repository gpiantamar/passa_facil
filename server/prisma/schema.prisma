// Prisma schema para sistema de passadoria de roupas
// Compatível com PostgreSQL (Supabase / Neon / Render / Railway)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Cliente {
  id        String   @id @default(uuid())
  nome      String
  telefone  String
  endereco  String?
  createdAt DateTime @default(now())

  // Relacionamento com Pedido
  pedidos   Pedido[]

  @@map("clientes")
}

model Servico {
  id          String       @id @default(uuid())
  nome        String       // Ex: Camisa Social, Lençol, Calça
  preco       Float
  unidade     String       @default("un") // "un" ou "kg"

  // Relacionamento com Itens de Pedido
  itensPedido ItemPedido[]

  @@map("servicos")
}

model Pedido {
  id           String       @id @default(uuid())
  clienteId    String
  status       String       @default("recebido") // "recebido", "passando", "pronto", "entregue"
  valorTotal   Float
  observacoes  String?
  previsaoPara DateTime?
  createdAt    DateTime     @default(now())

  // Relacionamentos
  cliente      Cliente      @relation(fields: [clienteId], references: [id])
  itens        ItemPedido[]

  @@map("pedidos")
}

model ItemPedido {
  id         String   @id @default(uuid())
  pedidoId   String
  servicoId  String
  quantidade Int
  valorUnit  Float

  // Deleção em cascata com Pedido
  pedido     Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade)
  servico    Servico  @relation(fields: [servicoId], references: [id])

  @@map("itens_pedido")
}
